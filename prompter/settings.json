{
    "enableAllProjectMcpServers": true,
    "permissions": {
        "allow": [
            "Read",
            "Grep",
            "Glob",
            "Edit",
            "Write",
            "MultiEdit",
            "WebFetch",
            "Bash(curl *)",
            "Bash(sqlite3 *)",
            "Bash(git *)",
            "Bash(npm *)",
            "Bash(npx *)",
            "Bash(scripts/*)",
            "Bash(bash scripts/*)",
            "Bash(tmux ls*)",
            "Bash(tmux capture-pane*)",
            "Bash(ls *)",
            "Bash(cat *)",
            "Bash(jq *)",
            "Bash(tail *)",
            "Bash(head *)",
            "Bash(grep *)",
            "Bash(rg *)",
            "Bash(fd *)",
            "mcp__mempalace__*"
        ],
        "deny": [
            "Bash(git push*)",
            "Bash(git * --force*)",
            "Bash(rm -rf /*)",
            "Bash(tmux send-keys*)",
            "Bash(tmux kill*)"
        ]
    }
}
